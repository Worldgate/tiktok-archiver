# --- Media never goes to GitHub ---
mogul_library/
mogul_quarantine/
mogul_incoming/

# Safety net: block audio/video files anywhere in the repo
*.mp4
*.webm
*.mkv
*.mov
*.m4a
*.mp3
*.aac
*.ogg
*.opus
*.part

# --- Kept on this machine only ---
# Private, user-specific files: cookies, block list, reports, raw listings.
mogul_userdata/
# The TikTok catalog isn't shared (nobody wants to mirror all of it).
# MOGUL pushes mogul_json/ on purpose: at merge time, ignore
# mogul_json/tiktok/ there instead.
mogul_json/
mogul_reports/

# --- This machine's settings, cookies and secrets ---
mogul.local.toml
secrets.toml
cookies.txt
*cookies*.txt
.env

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
