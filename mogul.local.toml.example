# mogul.local.toml: settings for THIS machine only.
#
# Copy this file to mogul.local.toml and edit it:
#     cp mogul.local.toml.example mogul.local.toml
#
# mogul.local.toml is in .gitignore, so it never goes to GitHub.
# Put anything here that you don't want public: drive paths, folder
# layouts. Anything set here overrides mogul.toml; anything left out
# uses the value from mogul.toml.

[core]
# json_store = "/home/you/tiktok-archiver/mogul_json"
# userdata = "/home/you/tiktok-archiver/mogul_userdata"

[tiktok]
# Point this at your existing video folders (the old tiktok_cache),
# then run "mogul.py tiktok scan" to catalog what's already there.
# library = "/mnt/STORAGE1/tiktok_cache"
# quarantine = "/mnt/STORAGE1/tiktok_quarantine"
# Cookies default to mogul_userdata/tiktok/cookies.txt; only set this to keep
# them somewhere else.
# cookies = "/home/you/tiktok_metadata/cookies.txt"

# Different drives per category (primary category of each account).
# Categories not listed here use library above. After changing these,
# run "mogul.py tiktok move" to carry the files over.
# [tiktok.drives]
# aigen = "/mnt/drive1/tiktok-archive"
# commentary = "/mnt/drive2/tiktok-archive"
# horror = "/mnt/drive2/tiktok-archive"
