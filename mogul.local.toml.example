# mogul.local.toml: settings for THIS machine only.
#
# Copy this file to mogul.local.toml and edit it:
#     cp mogul.local.toml.example mogul.local.toml
#
# mogul.local.toml is in .gitignore, so it never goes to GitHub.
# Put anything here that you don't want public: drive paths, folder
# layouts. Anything set here overrides mogul.toml; anything left out
# uses the value from mogul.toml.

[core]
# json_store = "/home/you/tiktok-archiver/mogul_json"
# userdata = "/home/you/tiktok-archiver/mogul_userdata"

[tiktok]
# Base folder for every category NOT listed under [tiktok.drives] below.
# Each base holds mogul_library/, mogul_incoming/, mogul_blocked/ and
# mogul_quarantine/ (each with a tiktok/ folder inside).
# base = "/mnt/STORAGE1/tiktok-archiver"

# Cookies default to mogul_userdata/tiktok/cookies.txt; only set this to
# keep them somewhere else.
# cookies = "/home/you/tiktok_metadata/cookies.txt"

# Base folder per category (the account's primary category). Several
# categories can share a base. Everything after this header belongs to it,
# so keep other [tiktok] settings ABOVE it.
# After changing these, run "mogul.py tiktok move" to carry files over,
# and "mogul.py tiktok settings" to check where everything goes.
# [tiktok.drives]
# aigen = "/mnt/STORAGE2/tiktok-archiver"
# horror = "/mnt/STORAGE2/tiktok-archiver"
# commentary = "/mnt/STORAGE1/tiktok-archiver"
